{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "diagnostics.globals": [
    "LibStub",
    "GetLocale",
    "CreateFont",
    "CreateFrame",
    "UIParent",
    "GameFontNormal",
    "GameFontNormalSmall",
    "GameFontHighlightSmall",
    "C_Timer",
    "hooksecurefunc",
    "ToggleDropDownMenu",
    "UIDROPDOWNMENU_OPEN_MENU",
    "describe",
    "it",
    "before_each",
    "after_each",
    "setup",
    "teardown",
    "pending",
    "finally",
    "require",
    "loadfile",
    "arg",
    "strmatch",
    "table",
    "string",
    "pairs",
    "ipairs",
    "type",
    "tostring",
    "tonumber",
    "next",
    "select",
    "assert",
    "error",
    "setmetatable",
    "rawget",
    "_G"
  ],
  "diagnostics.disable": [
    "lowercase-global",
    "undefined-global",
    "trailing-space",
    "undefined-field"
  ],
  "workspace.ignoreDir": [
    ".vscode",
    "libs",
    "Tests/wowapi"
  ],
  "workspace.library": [],
  "completion.enable": true,
  "hint.enable": true,
  "type.castNumberToInteger": true
}
